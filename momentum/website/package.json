{
  "name": "momentum-website",
  "version": "0.0.0",
  "private": true,
  "//": "image-size is pinned to 2.0.2 only while patches/image-size+2.0.2.patch is needed; remove both when upstream ships a fixed release.",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "yarn doxydoc && docusaurus build",
    "doxydoc": "/bin/bash -c 'cd .. && mkdir -p \"website/build/doxygen\" && doxygen Doxyfile'",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "test:image-size-security": "node scripts/test-image-size-security.cjs",
    "ci": "yarn lint && yarn prettier:diff",
    "lint": "eslint --cache \"**/*.js\" && stylelint \"**/*.css\"",
    "prettier": "prettier --config .prettierrc --write \"**/*.{js,jsx,ts,tsx,md,mdx}\"",
    "prettier:diff": "prettier --config .prettierrc --list-different \"**/*.{js,jsx,ts,tsx,md,mdx}\"",
    "postinstall": "patch-package --error-on-fail"
  },
  "dependencies": {
    "@algolia/client-search": "^5.56.0",
    "@docusaurus/core": "^3.2.1",
    "@docusaurus/preset-classic": "^3.2.1",
    "@docusaurus/theme-classic": "^3.2.1",
    "@mdx-js/react": "^3.0.1",
    "clsx": "^2.1.1",
    "docusaurus-plugin-internaldocs-fb": "^1.19.2",
    "nth-check": ">=2.0.1",
    "prism-react-renderer": "<2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-loadable": "^5.5.0",
    "typescript": "^7.0.2"
  },
  "resolutions": {
    "**/path-to-regexp": "^3.3.0",
    "dompurify": ">=3.4.0",
    "**/minimatch": "^3.1.4",
    "**/serialize-javascript": ">=7.0.5",
    "**/nth-check": ">=2.0.1",
    "**/webpack-dev-server": ">=5.2.1",
    "**/on-headers": ">=1.1.0",
    "**/image-size": "2.0.2",
    "**/js-yaml": "^4.3.1",
    "**/gray-matter": ">=4.0.3",
    "**/node-forge": ">=1.4.0",
    "@docsearch/react": "^4.6.3",
    "@docusaurus/**/mdast-util-to-hast": "13.2.1",
    "**/diff": ">=8.0.3",
    "**/lodash": ">=4.18.0",
    "**/lodash-es": ">=4.18.0",
    "**/svgo": "^3.3.3",
    "**/picomatch": "^2.3.2",
    "**/webpack-dev-server/ws": ">=8.20.1",
    "**/webpack-bundle-analyzer/ws": "^7.5.11",
    "**/yaml": ">=2.8.3",
    "**/uuid": ">=14.0.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=16",
    "npm": "use yarn instead",
    "yarn": ">=1.22.0 <2"
  },
  "devDependencies": {
    "image-size": "2.0.2",
    "patch-package": "^8.0.0"
  }
}
